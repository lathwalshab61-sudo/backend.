# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS Origin (e.g. https://your-frontend-domain.com or * for all)
CORS_ORIGIN=*

# MongoDB Atlas Connection String
# Replace with your actual credentials: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fingerscope_db?retryWrites=true&w=majority
